{
  "name": "networth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "local:setup": "node scripts/setup-local.mjs",
    "deploy:prepare": "node --conditions=react-server --import tsx scripts/deploy-prepare.ts",
    "deploy:enable": "node --env-file=.env.deploy.local --conditions=react-server --import tsx scripts/deploy-enable.ts",
    "deploy:check": "node --env-file=.env.deploy.local --conditions=react-server --import tsx scripts/deploy-check.ts",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:generate": "drizzle-kit generate",
    "inngest:dev": "inngest-cli dev --host 127.0.0.1 --no-discovery -u http://127.0.0.1:3000/api/inngest",
    "local:auth": "node scripts/prepare-local-auth.mjs",
    "db:migrate": "node --conditions=react-server --import tsx scripts/admin.ts migrate",
    "auth:recover-owner": "node --conditions=react-server --import tsx scripts/admin.ts recover-owner",
    "test:e2e:auth": "node --conditions=react-server node_modules/@playwright/test/cli.js test --config playwright.auth.config.ts",
    "workflows:prepare": "node --conditions=react-server --import tsx scripts/admin.ts prepare-worker",
    "workflows:verify": "node --conditions=react-server --import tsx scripts/admin.ts verify-capacity"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@node-rs/argon2": "2.2.1",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "inngest": "4.20.0",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "papaparse": "5.7.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@next/env": "16.3.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "inngest-cli": "1.44.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "$vite",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "inngest-cli": {
      "adm-zip": "0.6.1"
    }
  }
}
