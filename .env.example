# Server-only settings. Run npm run local:setup for isolated local development.
# Never prefix secrets with NEXT_PUBLIC_. Keep real values out of Git.

# Postgres connection string. Hosted connections require TLS verification.
DATABASE_URL=
# Separate migration/admin connection; never use it for ordinary requests.
DATABASE_ADMIN_URL=
# Independent signing/encryption secret, at least 32 characters.
AUTH_SECRET=
# One-time first-owner setup secret, at least 32 characters; remove after setup.
BOOTSTRAP_SECRET=
# Trusted app origin. HTTPS in production; HTTP loopback allowed locally.
APP_URL=
# Production Inngest credentials. Leave empty for the local Dev Server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_SIGNING_KEY_FALLBACK=
# Set to 1 only for local development. Never in a hosted environment.
INNGEST_DEV=
# Disposable loopback-only database named networth_test for integration checks.
TEST_DATABASE_URL=

# Optional synthetic UI preview. Requires a loopback APP_URL; disabled on Vercel.
LOCAL_UI_PREVIEW=

# Optional production-build testing, only with loopback HTTP and loopback Postgres.
LOCAL_RUNTIME=
